# The Zynq FCLK configuration domain and the AD9361 receive-clock domain
# are asynchronous.  The data-clock group includes clk_out3, generated by
# the MMCM from the AD9361 receive clock.
# AD9361 data clock is 122.4 MHz for the configured 61.2 MS/s 1R1T link.
# Anchor it at the board input so LVDS registers and the MMCM share one root.
create_clock -name ad9361_rx_clk -period 8.170 [get_ports rx_clk_in_p]
# Clock Wizard also creates a scoped clk_in_160m root on this same radio clock.
# Include that root and its outputs in the PS/radio asynchronous relationship.
set_clock_groups -asynchronous -group [get_clocks {clk_fpga_0 clk_fpga_1}] -group [get_clocks -include_generated_clocks {ad9361_rx_clk *clk_in_160m}]


























